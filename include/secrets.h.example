#pragma once
// คัดลอกไฟล์นี้เป็น include/secrets.h แล้วใส่ค่าจริง
// include/secrets.h อยู่ใน .gitignore แล้ว ห้าม commit (เกณฑ์ข้อ 4.5 และ E5)

// Hotspot มือถือ (ต้องเป็น 2.4 GHz) — gateway ใช้ต่อเน็ต, node ใช้แค่ชื่อเพื่อหา channel
#define WIFI_SSID     "your-hotspot-ssid"
#define WIFI_PASSWORD "your-hotspot-password"

// NETPIE2020 > Project > Device > Key (gateway ใช้)
#define NETPIE_CLIENT_ID "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
#define NETPIE_TOKEN     "your-device-token"
#define NETPIE_SECRET    "your-device-secret"

// MAC ของ gateway (node ใช้): upload gateway ก่อน แล้ว copy บรรทัดที่ Serial Monitor พิมพ์มาวางแทน
#define GATEWAY_MAC {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}
